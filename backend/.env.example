# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_CRITIQUE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Database Configuration
DATABASE_URL=postgresql://legaltrace_user:legaltrace_pass@localhost:5432/legaltrace_db

# LangGraph Checkpointing
CHECKPOINT_DB_URL=postgresql://legaltrace_user:legaltrace_pass@localhost:5432/legaltrace_db

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256

# Monitoring & Observability
PROMETHEUS_PORT=9090
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Environment
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
