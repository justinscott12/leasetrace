{
  "name": "leasetrace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Checks Florida residential leases against F.S. ch. 83 Part II. Not legal advice.",
  "scripts": {
    "corpus:fetch": "tsx scripts/fetch-corpus.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "labels:review": "tsx scripts/labels-review.ts",
    "hard:build": "tsx scripts/build-hard-set.ts",
    "site:data": "tsx scripts/build-site-data.ts",
    "dev": "vite",
    "build": "npm run site:data && vite build",
    "preview": "vite preview",
    "replays:record": "tsx scripts/record-replays.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  }
}
